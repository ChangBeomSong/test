<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

  <changeSet id="001-create-sample" author="you">
    <createTable tableName="SAMPLE_USER">
      <column name="USER_ID" type="NUMBER(10)">
        <constraints nullable="false" primaryKey="true"/>
      </column>
      <column name="USER_NAME" type="VARCHAR2(50)">
        <constraints nullable="false"/>
      </column>
      <column name="CREATED_AT" type="DATE"/>
    </createTable>

    <!-- Oracle 11g: IDENTITY 없음 -> SEQ + TRIGGER -->
    <createSequence sequenceName="SEQ_SAMPLE_USER" startValue="1" incrementBy="1"/>

    <sql>
      CREATE OR REPLACE TRIGGER TRG_SAMPLE_USER_BI
      BEFORE INSERT ON SAMPLE_USER
      FOR EACH ROW
      WHEN (new.USER_ID IS NULL)
      BEGIN
        SELECT SEQ_SAMPLE_USER.NEXTVAL INTO :new.USER_ID FROM dual;
      END;
    </sql>
  </changeSet>

</databaseChangeLog>